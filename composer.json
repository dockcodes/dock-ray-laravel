{
  "name": "dockcodes/dock-ray-laravel",
  "type": "library",
  "description": "Laravel bridge for the DockRay PHP SDK",
  "keywords": ["laravel", "error-monitoring", "crash-reporting", "performance-monitoring"],
  "license": "MIT",
  "authors": [
    {
      "name": "Jacek Sultan",
      "email": "j.sultan@dock.codes",
      "homepage": "https://dockray.io"
    }
  ],
  "require": {
    "php": "^7.4 || ^8.0",
    "dockcodes/dock-ray": "^1.0",
    "illuminate/contracts": "^6.0|^7.0|^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
    "illuminate/support": "^6.0|^7.0|^8.0|^9.0|^10.0|^11.0|^12.0|^13.0"
  },
  "require-dev": {
    "orchestra/testbench": "^4.0|^5.0|^6.0|^7.0|^8.0|^9.0|^10.0"
  },
  "autoload": {
    "psr-4": {
      "Dock\\Ray\\Laravel\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Dock\\Ray\\Laravel\\RayServiceProvider"
      ]
    }
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
